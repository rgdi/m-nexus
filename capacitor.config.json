{
  "appId": "com.mnexus.app",
  "appName": "M-NEXUS",
  "webDir": "frontend-bundle",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0f1115"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0f1115",
      "androidSplashResourceName": "splash",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f1115"
    }
  }
}
