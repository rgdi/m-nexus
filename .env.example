# M-NEXUS .env — environment for docker-compose.
# Copy to .env and fill the JWT_SECRET with `openssl rand -hex 32`.

# Required: 64-char hex secret for JWT signing.
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Optional
PORT=4100
HOST=0.0.0.0
DATA_DIR=/data
BACKUP_DIR=/backups
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://yourdomain.com

# Logging
LOG_LEVEL=info

# AI (optional; one of ollama/openrouter/openai)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# OCR (optional; Tesseract path on host)
TESSERACT_LANGS=spa+eng

# WebView bundle served by Nginx container, on port 8080.
WEB_DOMAIN=localhost:8080
