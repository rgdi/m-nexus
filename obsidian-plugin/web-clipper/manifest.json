{
  "manifest_version": 3,
  "name": "M-NEXUS Web Clipper",
  "version": "0.33.0",
  "description": "Guarda páginas web como notas de M-NEXUS con extracción de metadatos.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip a M-NEXUS"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
