#!/usr/bin/env python3
# Whisper CLI wrapper para M-NEXUS backend.
# Implementa la interfaz CLI que el backend espera (ver backend/src/services/whisper.ts):
#   whisper <audio_path> --model <model> --output-format json --language <lang>
# Y devuelve JSON a stdout.

import argparse
import json
import sys
import time
from pathlib import Path

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("audio", help="path to audio file")
    parser.add_argument("--model", default="base", help="whisper model (tiny, base, small, medium, large-v3)")
    parser.add_argument("--language", default="auto", help="language code or 'auto'")
    parser.add_argument("--output-format", default="json", help="output format")
    parser.add_argument("--threads", type=int, default=4, help="CPU threads")
    args = parser.parse_args()

    try:
        from faster_whisper import WhisperModel
    except ImportError:
        print(json.dumps({"error": "faster-whisper not installed. Run: pip install --break-system-packages faster-whisper"}), file=sys.stderr)
        sys.exit(2)

    audio_path = Path(args.audio)
    if not audio_path.exists():
        print(json.dumps({"error": f"audio file not found: {args.audio}"}), file=sys.stderr)
        sys.exit(3)

    # Map "tiny/base/small/medium/large" → actual model name
    model_map = {
        "tiny": "tiny",
        "base": "base",
        "small": "small",
        "medium": "medium",
        "large": "large-v3",
        "large-v3": "large-v3",
    }
    model_name = model_map.get(args.model, "base")

    lang = None if args.language == "auto" else args.language

    start = time.time()
    try:
        model = WhisperModel(model_name, device="cpu", compute_type="int8", cpu_threads=args.threads)
        segments_iter, info = model.transcribe(
            str(audio_path),
            language=lang,
            beam_size=5,
            vad_filter=True,
        )
        segments = []
        full_text = []
        for seg in segments_iter:
            segments.append({"start": seg.start, "end": seg.end, "text": seg.text.strip()})
            full_text.append(seg.text.strip())
        duration = time.time() - start
        result = {
            "text": " ".join(full_text),
            "language": info.language,
            "language_probability": info.language_probability,
            "duration": info.duration,
            "durationSec": info.duration,
            "segments": segments,
            "model": model_name,
            "transcriptionDurationSec": duration,
        }
        print(json.dumps(result, ensure_ascii=False))
    except Exception as e:
        print(json.dumps({"error": str(e)}), file=sys.stderr)
        sys.exit(4)

if __name__ == "__main__":
    main()
