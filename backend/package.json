{
  "name": "m-nexus-backend",
  "version": "0.30.0",
  "description": "Backend central de M-NEXUS: Whisper (sync+stream), OCR, LLM, embeddings, generaci\u00f3n de flashcards, PDF diff, dashboard web. Thin-client architecture.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/compress": "^7.0.3",
    "pino": "^9.3.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.0.0",
